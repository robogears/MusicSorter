# Hoist dependencies into a flat `node_modules/` layout.
#
# Required for electron-builder: with pnpm's default symlinked layout,
# transitive deps live only under `node_modules/.pnpm/...` and the packager
# misses them when building app.asar. That produced
# `Cannot find package 'ieee754'` at launch in v0.2.0 (ieee754 is pulled in
# via music-metadata → file-type → @tokenizer/inflate → token-types).
#
# Hoisted layout = npm-style flat tree the packager already handles.
node-linker=hoisted
