# Secrets — the real config has your Last.fm API key.
# Commit config.json.example as a template instead.
config.json

# Electron build outputs (artifacts ship as GitHub release assets, not
# committed). NOTE: `app/build/` is intentionally NOT ignored — it holds
# build resources (icons, entitlements, afterPack hook).
app/out/
app/dist/

# Leftover output dirs from the retired Python build, still on disk for
# anyone who packaged locally before the retirement. Anchored with `/` so
# the patterns don't shadow `app/build/`.
/build/
/dist/
*.spec
